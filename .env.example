# know-ci environment -- copy to .env and fill in, then chmod 600 .env

# --- Gitea public address ------------------------------------------------
# The hostname:port that external clients (Mac, Windows host) use to reach
# Gitea. This is the Windows-forward address, NOT the VM's internal IP.
#
# MUST match the KNOW_GITEA_* entries in know-tools/bin/port-forward.ps1.
# If you change these, change FORWARDS array in port-forward.ps1 too.
#
# Current topology:
#   Mac/Windows -> 10.255.255.254:{3001,2222} -> (Windows forward)
#               -> 172.26.60.57:{3001,2222} -> (VM host port)
#               -> container:3000,22
KNOW_GITEA_HOST=10.255.255.254
KNOW_GITEA_HTTP_PORT=3001
KNOW_GITEA_SSH_PORT=2222

# --- Gitea application secrets -------------------------------------------
# Generate each with: openssl rand -hex 32
# Persisted in state volume; rotate only with data migration.
GITEA_SECRET_KEY=
GITEA_INTERNAL_TOKEN=

# --- Runner --------------------------------------------------------------
# Image used by gitea/act_runner to execute workflow jobs.
RUNNER_IMAGE=gitea/runner-images:ubuntu-26.04

# Token obtained from Gitea UI (Site Administration -> Actions -> Runners).
# Leave empty until Gitea is running and admin user created.
RUNNER_REGISTRATION_TOKEN=